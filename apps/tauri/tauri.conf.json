{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CrossUI Bench",
  "version": "0.1.0",
  "identifier": "dev.crossui.bench",
  "build": {
    "beforeDevCommand": "npm --prefix .. run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm --prefix .. run build",
    "frontendDist": "../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "CrossUI Bench",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:1490; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": false
  }
}
